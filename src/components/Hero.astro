---
import { Picture } from 'astro:assets';
import hero from '../assets/home/hero.jpg';
// on phones the hero is a tall crop of a wide photo, shown about 1.75 screen heights wide
export const heroOptions = { widths: [640, 1024, 1600, 2048, 2880, 4096], sizes: '(max-width:700px) 175vh, 100vw' };
---
<header class="hero">
  <Picture
    src={hero}
    {...heroOptions}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    alt="A stone facade seen straight on at night, each recess uplit from fittings in the paving"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <a class="brand" href="#top"><svg class="logo" role="img" aria-label="Vellum, architectural lighting design"><use href="#vl"></use></svg><span class="brand-sub">Architectural lighting design</span></a>
  <div class="hero-copy">
    <h1 class="hero-h1">We design how buildings and interiors look after dark</h1>
    <a class="btn btn-dark hero-cta" href="#contact">Contact us <svg viewBox="0 0 9 9" aria-hidden="true"><path d="M1 8 8 1M2 1h6v6" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg></a>
  </div>
  <p class="hero-note">Facade uplight study<br />2700K · 15° · 40% dim</p>
</header>

---
import { Picture } from 'astro:assets';
import concept from '../assets/home/method-concept.jpg';
import detail from '../assets/home/method-detail.jpg';
import commissioning from '../assets/home/method-commissioning.jpg';
// on phones the panel is 300px tall, so a wide image is cropped from about 540px across
const wide = { widths: [640, 1024, 1600, 2048, 2752], sizes: '(max-width:700px) 540px, calc(100vw - 48px)' };
// the Specification panel: the lobby's luminaire schedule, one entry per fitting type
const fittings = [
  { ref: 'G01', type: 'Linear wall grazer, recessed', cct: '2700K', cri: '95', beam: '10×60°', ugr: '<16', control: 'DALI-2', circuit: 'C1' },
  { ref: 'P02', type: 'Pendant, opal glass', cct: '2200K', cri: '90', beam: 'Diffuse', ugr: 'n/a', control: 'Phase', circuit: 'C2' },
  { ref: 'D03', type: 'Downlight, deep regressed', cct: '3000K', cri: '95', beam: '24°', ugr: '<13', control: 'DALI-2', circuit: 'C3' },
  { ref: 'D04', type: 'Downlight, adjustable', cct: '3000K', cri: '95', beam: '15°', ugr: '<13', control: 'DALI-2', circuit: 'C3' },
  { ref: 'S05', type: 'Step light, linear', cct: '2700K', cri: '90', beam: 'Asymmetric', ugr: 'n/a', control: 'DALI-2', circuit: 'C4' },
  { ref: 'E06', type: 'In-ground uplight, facade', cct: '2700K', cri: '90', beam: '8°', ugr: 'n/a', control: 'DMX', circuit: 'External' },
];
const specs = [['cct', 'CCT'], ['cri', 'CRI'], ['beam', 'Beam'], ['ugr', 'UGR'], ['control', 'Control'], ['circuit', 'Circuit']] as const;
---
<section class="method" id="practice" aria-labelledby="method-h" data-label="How we work">
  <div class="method-top">
    <div class="h2-pair" data-reveal>
      <h2 class="h2" id="method-h"><b>One team through all four stages</b></h2>
      <p class="h2">The people who draw your scheme also specify the fittings and aim them on site, so what gets built matches what was drawn.</p>
    </div>
    <!-- the stages change on their own; this stops and restarts them (WCAG 2.2.2) -->
    <button class="tick-btn stage-btn" type="button" aria-controls="steps" aria-label="Pause the stages">
      <svg class="i-pause" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1h2v8H2zM6 1h2v8H6z" fill="currentColor"></path></svg>
      <svg class="i-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"></path></svg>
    </button>
  </div>
  <div class="steps" id="steps" role="tablist" aria-label="How we work" data-reveal>
    <button class="step" type="button" role="tab" id="t0" aria-controls="p0" aria-selected="true"><span class="step-t">Concept</span><span class="step-d">Hand drawings of where light should fall and where it should not.</span></button>
    <button class="step" type="button" role="tab" id="t1" aria-controls="p1" aria-selected="false" tabindex="-1"><span class="step-t">Detail</span><span class="step-d">Section drawings of every slot, cove and niche, checked against your drawings.</span></button>
    <button class="step" type="button" role="tab" id="t2" aria-controls="p2" aria-selected="false" tabindex="-1"><span class="step-t">Specification</span><span class="step-d">A schedule of every fitting with its colour temperature, beam, glare rating and control circuit.</span></button>
    <button class="step" type="button" role="tab" id="t3" aria-controls="p3" aria-selected="false" tabindex="-1"><span class="step-t">Commissioning</span><span class="step-d">We aim and dim each fitting on site, after dark, until the room looks as drawn.</span></button>
  </div>
  <div class="stage" data-reveal>
    <div class="panel" role="tabpanel" id="p0" aria-labelledby="t0" tabindex="0">
      <Picture src={concept} {...wide} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="Perspective drawing of a hotel lobby, with gold arrows tracing light from downlights, a pendant over a stone bench and a grazed stone wall" />
    </div>
    <div class="panel" role="tabpanel" id="p1" aria-labelledby="t1" tabindex="0" hidden>
      <Picture src={detail} {...wide} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="Cutaway drawing of a recessed ceiling slot, with gold arrows showing light spilling down the wall and its cut-off angle" />
    </div>
    <div class="panel" role="tabpanel" id="p2" aria-labelledby="t2" tabindex="0" hidden>
      <!-- owner request: the plain table filled a third of the panel with one level of type. Now a composed schedule:
           title, project and three key figures on the left; the six fittings as a grid filling the height on the right,
           each with its reference, type and six labelled values. Tablets and phones: the fittings scroll sideways. -->
      <div class="spec">
        <div class="spec-head">
          <div>
            <h3 class="spec-t">Luminaire schedule</h3>
            <p class="spec-m">Hotel lobby, revision C, six fittings</p>
          </div>
          <dl class="spec-sum">
            <div><dt>Colour temperature</dt><dd>2200 to 3000K</dd></div>
            <div><dt>Colour rendering</dt><dd>CRI 90 to 95</dd></div>
            <div><dt>Glare, where rated</dt><dd>UGR below 16</dd></div>
          </dl>
        </div>
        <ul class="spec-list" role="list" aria-label="Fittings" tabindex="0">
          {fittings.map((f) => (
            <li class="fit">
              <div>
                <p class="fit-ref">{f.ref}</p>
                <h4 class="fit-t">{f.type}</h4>
              </div>
              <dl class="fit-d">
                {specs.map(([k, label]) => <div><dt>{label}</dt><dd>{f[k]}</dd></div>)}
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="panel" role="tabpanel" id="p3" aria-labelledby="t3" tabindex="0" hidden>
      <Picture src={commissioning} widths={[640, 1024, 1600, 2400, 3200]} sizes="(max-width:700px) 540px, calc(100vw - 48px)" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="A dark hotel lobby during commissioning: a step ladder against a limestone wall and one spotlight aimed at it" />
    </div>
  </div>
</section>

<script>
  // Tabs: click, or arrow keys/Home/End from the keyboard (WAI-ARIA tabs pattern).
  // They also advance on their own (Airloom's feature tabs): each stage stays up for STAGE_MS while its
  // gold line fills, then the next one takes over, looping. Choosing a stage jumps there and its line starts
  // filling again from empty. The pause button stops and restarts the rotation. It waits while keyboard focus
  // is on the stages, while the band is off screen and while the tab is hidden. With reduced motion it starts stopped.
  const STAGE_MS = 7000;

  const method = document.querySelector<HTMLElement>('.method')!;
  const tabs = [...method.querySelectorAll<HTMLButtonElement>('.step')];
  const tablist = method.querySelector<HTMLElement>('.steps')!;
  const btn = method.querySelector<HTMLButtonElement>('.stage-btn')!;

  // the tab list is a row on desktop and a stack on phones; tell assistive tech which
  const stacked = matchMedia('(max-width:700px)');
  const orient = () => tablist.setAttribute('aria-orientation', stacked.matches ? 'vertical' : 'horizontal');
  stacked.addEventListener('change', orient);
  orient();

  let current = 0;
  function select(i: number, focus = false) {
    current = i;
    tabs.forEach((t, j) => {
      const on = j === i;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      t.style.setProperty('--p', '0');
      const p = document.getElementById(t.getAttribute('aria-controls')!)!;
      p.hidden = !on;
      if (on) {
        p.classList.remove('in');
        void p.offsetWidth;
        p.classList.add('in');
      }
    });
    if (focus) tabs[i].focus();
  }

  // ---- timing
  // Respect the reduce-motion setting, unless ?motion=on was added for reviewing (sets html.force-motion, see Base.astro).
  const reduceQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const reduced = () => reduceQuery.matches && !document.documentElement.classList.contains('force-motion');

  let running = !reduced(); // false while the pause button has it stopped
  const waits = new Set<string>(['offscreen']); // temporary holds: keyboard focus, offscreen, hidden
  let elapsed = 0;
  let last = 0;
  let frame = 0;

  const setButton = () => {
    method.classList.toggle('is-auto', running);
    btn.setAttribute('aria-label', running ? 'Pause the stages' : 'Play the stages');
    btn.classList.toggle('is-stopped', !running);
  };

  const tick = (t: number) => {
    frame = 0;
    if (!running || waits.size) {
      last = 0;
      return;
    }
    elapsed += last ? t - last : 0;
    last = t;
    if (elapsed >= STAGE_MS) {
      elapsed = 0;
      select((current + 1) % tabs.length);
    }
    tabs[current].style.setProperty('--p', String(Math.min(1, elapsed / STAGE_MS)));
    frame = requestAnimationFrame(tick);
  };
  const wake = () => {
    if (!frame && running && !waits.size) frame = requestAnimationFrame(tick);
  };
  const hold = (why: string, on: boolean) => {
    if (on) waits.add(why);
    else waits.delete(why);
    wake();
  };
  const stop = () => {
    running = false;
    elapsed = 0;
    setButton();
  };

  btn.addEventListener('click', () => {
    if (running) stop();
    else {
      running = true;
      elapsed = 0;
      setButton();
      wake();
    }
  });

  new IntersectionObserver((entries) => hold('offscreen', !entries[0].isIntersecting), { threshold: 0.3 }).observe(method);
  document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
  // keyboard focus on the stages or panel holds it; a mouse click on a stage does not (it is not :focus-visible)
  method.addEventListener('focusin', (e) => {
    const t = e.target as HTMLElement;
    hold('focus', t !== btn && t.matches(':focus-visible'));
  });
  method.addEventListener('focusout', (e) => { if (!method.contains(e.relatedTarget as Node)) hold('focus', false); });

  // ---- choosing a stage jumps there and restarts its line; the rotation carries on from it
  const jump = (i: number, focus = false) => {
    select(i, focus);
    elapsed = 0;
    wake();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => jump(i));
    t.addEventListener('keydown', (e) => {
      // Left/Right across the row on desktop, Up/Down down the stack on phones; both work everywhere
      const k = ({ ArrowRight: 1, ArrowLeft: -1, ArrowDown: 1, ArrowUp: -1 } as Record<string, number>)[e.key];
      const to = k ? (i + k + tabs.length) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      jump(to, true);
    });
  });

  setButton();
</script>

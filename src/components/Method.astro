---
import { Picture } from 'astro:assets';
import concept from '../assets/home/sketch-concept.jpg';
import detail from '../assets/home/sketch-detail.jpg';
import graze from '../assets/home/graze-sm.jpg';
const wide = { widths: [640, 1024], sizes: '(max-width:700px) calc(100vw - 36px), calc(100vw - 48px)' };
---
<section class="method" id="practice" aria-labelledby="method-h" data-label="How we work">
  <div class="method-top">
    <h2 class="h2" id="method-h" data-reveal><b>From first sketch to final focus.</b> One team carries each scheme through four stages, so the light that gets built is the light that was drawn.</h2>
    <!-- the stages change on their own; this stops and restarts them (WCAG 2.2.2) -->
    <button class="tick-btn stage-btn" type="button" aria-controls="steps" aria-label="Pause the stages">
      <svg class="i-pause" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1h2v8H2zM6 1h2v8H6z" fill="currentColor"></path></svg>
      <svg class="i-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"></path></svg>
    </button>
  </div>
  <div class="steps" id="steps" role="tablist" aria-label="How we work" data-reveal>
    <button class="step" type="button" role="tab" id="t0" aria-controls="p0" aria-selected="true"><span class="step-n">01</span><span class="step-t">Concept</span><span class="step-d">Hand drawings that set where light lands, and where it doesn't.</span></button>
    <button class="step" type="button" role="tab" id="t1" aria-controls="p1" aria-selected="false" tabindex="-1"><span class="step-n">02</span><span class="step-t">Detail</span><span class="step-d">Sections through every slot, cove and niche, coordinated with your drawings.</span></button>
    <button class="step" type="button" role="tab" id="t2" aria-controls="p2" aria-selected="false" tabindex="-1"><span class="step-n">03</span><span class="step-t">Specification</span><span class="step-d">Fittings scheduled by colour temperature, beam, glare and control circuit.</span></button>
    <button class="step" type="button" role="tab" id="t3" aria-controls="p3" aria-selected="false" tabindex="-1"><span class="step-n">04</span><span class="step-t">Commissioning</span><span class="step-d">On site after dark, aiming and dimming each fitting until the room reads right.</span></button>
  </div>
  <div class="stage" data-reveal>
    <div class="panel" role="tabpanel" id="p0" aria-labelledby="t0" tabindex="0">
      <Picture src={concept} {...wide} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="Perspective drawing of a hotel lobby, with gold arrows tracing light from downlights, a pendant over a stone bench and a grazed stone wall" />
      <p class="panel-cap">Concept · lobby perspective · G01 graze · P02 pendant · D03 downlights</p>
    </div>
    <div class="panel" role="tabpanel" id="p1" aria-labelledby="t1" tabindex="0" hidden>
      <Picture src={detail} {...wide} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="Cutaway drawing of a recessed ceiling slot, with gold arrows showing light spilling down the wall and its cut-off angle" />
      <p class="panel-cap">Detail 04 · ceiling slot · 60° cut-off</p>
    </div>
    <div class="panel" role="tabpanel" id="p2" aria-labelledby="t2" tabindex="0" hidden>
      <div class="sched-wrap">
        <table class="sched">
          <caption>Luminaire schedule · lobby · rev C</caption>
          <thead><tr><th scope="col">Ref</th><th scope="col">Type</th><th scope="col">CCT</th><th scope="col">CRI</th><th scope="col">Beam</th><th scope="col">UGR</th><th scope="col">Control</th></tr></thead>
          <tbody>
            <tr><td>G01</td><td>Linear wall grazer, recessed</td><td>2700K</td><td>95</td><td>10×60°</td><td>&lt;16</td><td>DALI-2 · C1</td></tr>
            <tr><td>P02</td><td>Pendant, opal glass</td><td>2200K</td><td>90</td><td>Diffuse</td><td>n/a</td><td>Phase · C2</td></tr>
            <tr><td>D03</td><td>Downlight, deep regressed</td><td>3000K</td><td>95</td><td>24°</td><td>&lt;13</td><td>DALI-2 · C3</td></tr>
            <tr><td>D04</td><td>Downlight, adjustable</td><td>3000K</td><td>95</td><td>15°</td><td>&lt;13</td><td>DALI-2 · C3</td></tr>
            <tr><td>S05</td><td>Step light, linear</td><td>2700K</td><td>90</td><td>Asymmetric</td><td>n/a</td><td>DALI-2 · C4</td></tr>
            <tr><td>E06</td><td>In-ground uplight, facade</td><td>2700K</td><td>90</td><td>8°</td><td>n/a</td><td>DMX · EXT</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="panel" role="tabpanel" id="p3" aria-labelledby="t3" tabindex="0" hidden>
      <Picture src={graze} widths={[480, 645]} sizes="(max-width:700px) calc(100vw - 36px), calc(100vw - 48px)" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" alt="Warm light grazing down a rough stone wall from a ceiling slot, falling to darkness" />
      <p class="panel-cap">Focus night · 23:40 · G01 at 40%</p>
    </div>
  </div>
</section>

<script>
  // Tabs: click, or arrow keys/Home/End from the keyboard (WAI-ARIA tabs pattern).
  // They also advance on their own (Airloom's feature tabs): each stage stays up for STAGE_MS while its
  // gold line fills, then the next one takes over, looping. Choosing a stage jumps there and its line starts
  // filling again from empty. The pause button stops and restarts the rotation. It waits while keyboard focus
  // is on the stages, while the band is off screen and while the tab is hidden. With reduced motion it starts stopped.
  const STAGE_MS = 7000;

  const method = document.querySelector<HTMLElement>('.method')!;
  const tabs = [...method.querySelectorAll<HTMLButtonElement>('.step')];
  const tablist = method.querySelector<HTMLElement>('.steps')!;
  const btn = method.querySelector<HTMLButtonElement>('.stage-btn')!;

  // the tab list is a row on desktop and a stack on phones; tell assistive tech which
  const stacked = matchMedia('(max-width:700px)');
  const orient = () => tablist.setAttribute('aria-orientation', stacked.matches ? 'vertical' : 'horizontal');
  stacked.addEventListener('change', orient);
  orient();

  let current = 0;
  function select(i: number, focus = false) {
    current = i;
    tabs.forEach((t, j) => {
      const on = j === i;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      t.style.setProperty('--p', '0');
      const p = document.getElementById(t.getAttribute('aria-controls')!)!;
      p.hidden = !on;
      if (on) {
        p.classList.remove('in');
        void p.offsetWidth;
        p.classList.add('in');
      }
    });
    if (focus) tabs[i].focus();
  }

  // ---- timing
  // Respect the reduce-motion setting, unless ?motion=on was added for reviewing (sets html.force-motion, see Base.astro).
  const reduceQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const reduced = () => reduceQuery.matches && !document.documentElement.classList.contains('force-motion');

  let running = !reduced(); // false while the pause button has it stopped
  const waits = new Set<string>(['offscreen']); // temporary holds: keyboard focus, offscreen, hidden
  let elapsed = 0;
  let last = 0;
  let frame = 0;

  const setButton = () => {
    method.classList.toggle('is-auto', running);
    btn.setAttribute('aria-label', running ? 'Pause the stages' : 'Play the stages');
    btn.classList.toggle('is-stopped', !running);
  };

  const tick = (t: number) => {
    frame = 0;
    if (!running || waits.size) {
      last = 0;
      return;
    }
    elapsed += last ? t - last : 0;
    last = t;
    if (elapsed >= STAGE_MS) {
      elapsed = 0;
      select((current + 1) % tabs.length);
    }
    tabs[current].style.setProperty('--p', String(Math.min(1, elapsed / STAGE_MS)));
    frame = requestAnimationFrame(tick);
  };
  const wake = () => {
    if (!frame && running && !waits.size) frame = requestAnimationFrame(tick);
  };
  const hold = (why: string, on: boolean) => {
    if (on) waits.add(why);
    else waits.delete(why);
    wake();
  };
  const stop = () => {
    running = false;
    elapsed = 0;
    setButton();
  };

  btn.addEventListener('click', () => {
    if (running) stop();
    else {
      running = true;
      elapsed = 0;
      setButton();
      wake();
    }
  });

  new IntersectionObserver((entries) => hold('offscreen', !entries[0].isIntersecting), { threshold: 0.3 }).observe(method);
  document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
  // keyboard focus on the stages or panel holds it; a mouse click on a stage does not (it is not :focus-visible)
  method.addEventListener('focusin', (e) => {
    const t = e.target as HTMLElement;
    hold('focus', t !== btn && t.matches(':focus-visible'));
  });
  method.addEventListener('focusout', (e) => { if (!method.contains(e.relatedTarget as Node)) hold('focus', false); });

  // ---- choosing a stage jumps there and restarts its line; the rotation carries on from it
  const jump = (i: number, focus = false) => {
    select(i, focus);
    elapsed = 0;
    wake();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => jump(i));
    t.addEventListener('keydown', (e) => {
      // Left/Right across the row on desktop, Up/Down down the stack on phones; both work everywhere
      const k = ({ ArrowRight: 1, ArrowLeft: -1, ArrowDown: 1, ArrowUp: -1 } as Record<string, number>)[e.key];
      const to = k ? (i + k + tabs.length) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      jump(to, true);
    });
  });

  setButton();
</script>

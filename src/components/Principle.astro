---
import { Picture } from 'astro:assets';
import pillar from '../assets/home/principle.jpg';
---
<section class="principle" aria-label="Studio principle" data-label="Studio principle">
  <figure class="principle-fig" data-reveal>
    <Picture src={pillar} widths={[448, 730, 1100, 1460, 1856]} sizes="(max-width:700px) calc(100vw - 36px), 730px" formats={['avif', 'webp']} fallbackFormat="jpg" alt="A rough limestone pillar in a dark room, lit by one uplight at its base" loading="lazy" decoding="async" />
  </figure>
  <blockquote data-reveal style="--d:1">We plan what stays dark as carefully as what gets lit. Without contrast, a room at night looks flat.</blockquote>
  <footer data-reveal style="--d:2">Vellum<span>Studio principle</span></footer>
</section>

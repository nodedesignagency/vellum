---
import { Picture } from 'astro:assets';
import pillar from '../assets/home/principle.jpg';
---
<!-- Photo at its own 4:5 and the quote beside it after one fixed gap, centred on the photo's height, its lines
     balanced to even lengths (owner request: the 900px-tall photo made the section too tall and the words read as apart from it).
     Over the quote, "Vellum principle" is the section's heading in the same plain 18px style as the Collaborators line
     (.lede; owner requests: first a chip, then "make that chip like" the Collaborators heading). -->
<section class="principle" aria-labelledby="principle-h" data-label="Vellum principle">
  <figure class="principle-fig" data-reveal>
    <Picture src={pillar} widths={[448, 730, 1100, 1460, 1856]} sizes="(max-width:700px) calc(100vw - 36px), (max-width:882px) 300px, (max-width:1647px) 34vw, 560px" formats={['avif', 'webp']} fallbackFormat="jpg" alt="A rough limestone pillar in a dark room, lit by one uplight at its base" loading="lazy" decoding="async" />
  </figure>
  <div class="principle-t" data-reveal style="--d:1">
    <h2 class="lede" id="principle-h">Vellum principle</h2>
    <blockquote>We plan what stays dark as carefully as what gets lit. Without&nbsp;contrast, a&nbsp;room at night looks flat.</blockquote>
  </div>
</section>

---
import { Picture } from 'astro:assets';
import scallop from '../assets/home/scallop-sm.jpg';
import section from '../assets/home/sketch-section.jpg';
import stair from '../assets/home/stair-sm.jpg';
import graze from '../assets/home/graze-sm.jpg';
import beam from '../assets/home/beam-sm.jpg';

// One key paragraph held on screen while five photos pass it (review feedback: the earlier 333-style drift sent all
// three paragraphs through a long scroll, so they were hard to read). The photos travel in the free space around the
// text, never across it: up the outer columns on desktop, sideways above and below it on phones. Their start points
// and travel are in global.css (.d0 to .d4); the script below only reports how far through the hold the reader is.
const drifts = [scallop, section, stair, graze, beam];
---
<section class="story" id="content" aria-label="About the practice" data-label="The practice">
  <div class="story-pin">
    <div class="story-stage">
      <p class="story-lead" data-reveal><b>This is Vellum.</b> An architectural lighting practice that treats light as a building material, drawn, detailed and tuned with the same care as stone, timber or glass.</p>
      <div class="drifts" aria-hidden="true">
        {drifts.map((src, i) => (
          <figure class={`drift d${i}`}>
            <Picture src={src} widths={[160, 320, 480, 645]} sizes="(max-width:700px) 23vw, 13vw" formats={['avif', 'webp']} fallbackFormat="jpg" alt="" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </div>
  </div>
  <div class="story-copy">
    <p data-reveal><b>We work beside architects, developers and interior designers</b> from the first concept sketch to the night we focus the last fitting on site.</p>
    <p data-reveal style="--d:1"><b>Every project starts on paper.</b> We draw where the light falls before we choose what makes it.</p>
  </div>
</section>

<script>
  // Respect the reduce-motion setting, unless ?motion=on was added for reviewing (sets html.force-motion, see Base.astro).
  const reduceQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const reduce = {
    get matches() { return reduceQuery.matches && !document.documentElement.classList.contains('force-motion'); },
    addEventListener: (type: 'change', fn: () => void) => reduceQuery.addEventListener(type, fn),
  };
  // The hold: the stage sticks under the bar while the reader scrolls one screen; --p runs from 0 to 1 across it and
  // moves the photos (CSS: start point + travel x --p, in units of the stage's size). Locked to the native scroll.
  // With reduced motion, or without JavaScript, nothing is held and the photos rest halfway (--p: .5).
  const story = document.querySelector<HTMLElement>('.story');
  const pin = story?.querySelector<HTMLElement>('.story-pin');
  const stage = story?.querySelector<HTMLElement>('.story-stage');
  let queued = false;

  const update = () => {
    queued = false;
    if (!story || !pin || !stage || reduce.matches) return;
    const r = pin.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const top = parseFloat(getComputedStyle(stage).top) || 0;
    const range = r.height - stage.offsetHeight;
    const p = range > 0 ? Math.min(1, Math.max(0, (top - r.top) / range)) : 0;
    stage.style.setProperty('--p', p.toFixed(4));
  };

  const queue = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };

  const setMode = () => {
    if (!story || !stage) return;
    if (reduce.matches) {
      story.classList.remove('is-moving');
      stage.style.removeProperty('--p');
      return;
    }
    story.classList.add('is-moving');
    update();
  };

  // photos waiting outside the stage are clipped, so lazy loading would only fetch them as they slide in:
  // fetch them as the section comes within a screen of view instead
  if (story && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      story.querySelectorAll<HTMLImageElement>('.drift img').forEach((img) => (img.loading = 'eager'));
      near.disconnect();
    }, { rootMargin: '100% 0px' });
    near.observe(story);
  }

  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  reduce.addEventListener('change', setMode);
  setMode();
</script>

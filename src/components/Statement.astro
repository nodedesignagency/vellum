---
import { Picture } from 'astro:assets';
// the Statement's own photos (review feedback: they were the project covers again); larger copies are in the journal
import corridor from '../assets/home/drift-corridor.jpg';
import section from '../assets/home/drift-section.jpg';
import stair from '../assets/home/drift-stair.jpg';
import lobby from '../assets/home/drift-lobby.jpg';
import detail from '../assets/home/drift-detail.jpg';

// The three paragraphs share one held spot and change in place as the reader scrolls, while five photos pass around
// them (review feedback: the earlier 333-style drift sent all three through a long scroll, so they were hard to read;
// owner requests: fixed gaps, then the paragraphs back, swapping in the same place). The photos travel in the free space around the
// text, never across it: up the outer columns on desktop, sideways above and below it on phones. Their start points
// and travel are in global.css (.d0 to .d4); the script below only reports how far through the hold the reader is.
const drifts = [corridor, section, stair, lobby, detail];
---
<section class="story" id="content" aria-label="About the practice" data-label="The practice">
  <div class="story-pin">
    <div class="story-stage">
      <div class="story-lines">
        <p class="story-lead is-on"><b>Vellum is an architectural lighting studio.</b> We plan where light falls in a building, specify the fittings and set them up on site.</p>
        <p class="story-lead"><b>We work with architects, developers and interior designers</b>, usually from concept stage until the last fitting is aimed and dimmed.</p>
        <p class="story-lead"><b>Every project starts with drawings.</b> We sketch where the light should go before choosing any fittings.</p>
      </div>
      <div class="drifts" aria-hidden="true">
        {drifts.map((src, i) => (
          <figure class={`drift d${i}`}>
            <Picture src={src} widths={[160, 320, 480, 700, 1000, 1128]} sizes="(max-width:700px) 23vw, 13vw" formats={['avif', 'webp']} fallbackFormat="jpg" alt="" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </div>
    <div class="story-hold" aria-hidden="true"></div>
  </div>
</section>

<script>
  // Respect the reduce-motion setting, unless ?motion=on was added for reviewing (sets html.force-motion, see Base.astro).
  const reduceQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const reduce = {
    get matches() { return reduceQuery.matches && !document.documentElement.classList.contains('force-motion'); },
    addEventListener: (type: 'change', fn: () => void) => reduceQuery.addEventListener(type, fn),
  };
  // The hold: the stage (the paragraphs plus fixed gaps) sticks, centred in the space under the bar, while the reader
  // scrolls through .story-hold; --p runs from 0 to 1 across it and moves the photos (start point + travel x --p).
  // Each third of the hold shows one paragraph (.is-on), crossfading in the same place. Locked to the native scroll.
  // With reduced motion, or without JavaScript, nothing is held: the paragraphs stack and the photos rest (--p: .5).
  const story = document.querySelector<HTMLElement>('.story');
  const pin = story?.querySelector<HTMLElement>('.story-pin');
  const stage = story?.querySelector<HTMLElement>('.story-stage');
  const hold = story?.querySelector<HTMLElement>('.story-hold');
  const lines = [...(story?.querySelectorAll<HTMLElement>('.story-lead') ?? [])];
  const drifts = [...(story?.querySelectorAll<HTMLElement>('.drift') ?? [])];
  const desktop = matchMedia('(min-width:701px)');
  // desktop columns: which photos, where the first starts (half the block minus `lift` screens), how far apart they
  // are (`gap` screens) and how fast they rise compared with the scroll
  const lanes = [
    { items: [0, 2, 4], lift: 0.35, gap: 0.7, speed: 120 / 210 },
    { items: [1, 3], lift: 0.05, gap: 1.1, speed: 160 / 210 },
  ];
  let step = 0;
  let queued = false;

  const show = (n: number) => {
    if (n === step) return;
    step = n;
    lines.forEach((l, i) => l.classList.toggle('is-on', i === n));
  };

  const update = () => {
    queued = false;
    if (!story || !pin || !stage || reduce.matches) return;
    const r = pin.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const top = parseFloat(stage.style.top) || 0;
    const range = r.height - stage.offsetHeight;
    const p = range > 0 ? Math.min(1, Math.max(0, (top - r.top) / range)) : 0;
    stage.style.setProperty('--p', p.toFixed(4));
    show(Math.min(lines.length - 1, Math.floor(p * lines.length)));
  };

  const queue = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };

  // Where the stage sticks (centred in the screen below the bar, or right under the bar if it is taller than that),
  // and on desktop each photo's start and its column's travel. The section clips the photos at its edges, so:
  //  - the lowest photo of a column must finish the hold whole above the section's bottom edge, which rises past
  //    photos moving slower than the scroll (end point E = block height - photo - 16px);
  //  - if that makes a column rise faster than the scroll, it would catch the section's top edge while that edge is
  //    still on screen (for D px of scrolling), so it starts lower: at least D x (travel / hold - 1) + 16px.
  // Phones use the CSS rows (sideways), so the inline values are cleared there.
  const place = () => {
    if (!stage) return;
    const vh = innerHeight;
    const bar = document.querySelector<HTMLElement>('.bar')?.offsetHeight ?? 0;
    const sh = stage.offsetHeight;
    const top = Math.max(bar, Math.round((vh + bar - sh) / 2));
    stage.style.top = `${top}px`;
    drifts.forEach((d) => {
      d.style.removeProperty('top');
      d.style.removeProperty('--ty');
    });
    if (!desktop.matches || !hold) return;
    const H = hold.offsetHeight;
    const D = top - bar;
    for (const lane of lanes) {
      const els = lane.items.map((i) => drifts[i]).filter(Boolean);
      if (!els.length) continue;
      const ph = els[0].offsetHeight;
      const S = lane.gap * vh;
      const k = els.length - 1;
      const E = sh - ph - 16;
      let y0 = Math.max(16, sh / 2 - lane.lift * vh);
      let T = lane.speed * H;
      for (let n = 0; n < 8; n++) {
        T = Math.max(lane.speed * H, y0 + k * S - E);
        const floor = T > H ? D * (T / H - 1) + 16 : 16;
        if (y0 >= floor) break;
        y0 = floor;
      }
      els.forEach((el, j) => {
        el.style.top = `${Math.round(y0 + j * S)}px`;
        el.style.setProperty('--ty', `${-Math.round(T)}px`);
      });
    }
  };

  const setMode = () => {
    if (!story || !stage) return;
    if (reduce.matches) {
      story.classList.remove('is-moving');
      stage.style.removeProperty('--p');
      stage.style.removeProperty('top');
      drifts.forEach((d) => {
        d.style.removeProperty('top');
        d.style.removeProperty('--ty');
      });
      return;
    }
    story.classList.add('is-moving');
    place();
    update();
  };

  // photos waiting outside the stage are clipped, so lazy loading would only fetch them as they slide in:
  // fetch them as the section comes within a screen of view instead
  if (story && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      story.querySelectorAll<HTMLImageElement>('.drift img').forEach((img) => (img.loading = 'eager'));
      near.disconnect();
    }, { rootMargin: '100% 0px' });
    near.observe(story);
  }

  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', () => {
    if (story?.classList.contains('is-moving')) place();
    queue();
  });
  reduce.addEventListener('change', setMode);
  setMode();
</script>
